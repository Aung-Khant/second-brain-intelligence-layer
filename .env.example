# ---------------------------------------------------------------------------
# Shared backend credentials. These belong to the server, not to any one user.
# ---------------------------------------------------------------------------

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Notion public integration, from notion.so/my-integrations. Create an
# integration of type "Public" and add the redirect URI below to it. Every user
# signs in through this one integration; their individual workspace tokens are
# stored per connection and encrypted.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://127.0.0.1:3737/api/auth/notion/callback

# Shown on the /start onboarding page as "duplicate this template" before the
# person connects. Must be a link Notion generated by turning on "Share to
# web" -> "Allow duplicate as a template" on the page - it will look like
# https://<name>.notion.site/... An app.notion.com/p/... URL is the private,
# logged-in address bar link and will NOT work for anyone but you.
# Leave blank to skip step 1 and show only "Connect Notion".
NOTION_TEMPLATE_URL=

# Encrypts stored Notion access tokens at rest. Required - there is no
# unencrypted fallback. Generate with:  openssl rand -hex 32
# Changing this makes every existing connection unreadable, forcing everyone to
# reconnect.
TOKEN_ENCRYPTION_KEY=

NOTION_VERSION=2026-03-11

# Where connections are stored. Keep this off any path you might commit.
CONNECTIONS_STORE_PATH=data/connections.json

# ---------------------------------------------------------------------------
# Single-user local development fallback.
#
# Used only when a request arrives with no session at all AND
# ALLOW_LOCAL_ENV_FALLBACK is set to true. It is the old pre-OAuth setup, kept
# working for local development, and it can only ever describe one workspace -
# it is not a deployment path.
#
# Leave ALLOW_LOCAL_ENV_FALLBACK unset on any server other people use. With it
# on, anyone who installs the extension without connecting their own Notion
# would silently save into THIS workspace instead of being asked to sign in.
#
# The four data source ids have no defaults: a default here pointed every
# install at one specific workspace, which is what made the product
# single-user in the first place.
# ---------------------------------------------------------------------------

ALLOW_LOCAL_ENV_FALLBACK=false
NOTION_API_KEY=
NOTION_AREAS_DATA_SOURCE_ID=
NOTION_TOPICS_DATA_SOURCE_ID=
NOTION_PROJECTS_DATA_SOURCE_ID=
NOTION_RESOURCES_DATA_SOURCE_ID=
