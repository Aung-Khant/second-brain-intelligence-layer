# ---------------------------------------------------------------------------
# Shared backend credentials. These belong to the server, not to any one user.
# ---------------------------------------------------------------------------

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Notion public integration, from notion.so/my-integrations. Create an
# integration of type "Public" and add the redirect URI below to it. Every user
# signs in through this one integration; their individual workspace tokens are
# stored per connection and encrypted.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://127.0.0.1:3737/api/auth/notion/callback

# Encrypts stored Notion access tokens at rest. Required - there is no
# unencrypted fallback. Generate with:  openssl rand -hex 32
# Changing this makes every existing connection unreadable, forcing everyone to
# reconnect.
TOKEN_ENCRYPTION_KEY=

NOTION_VERSION=2026-03-11

# Where connections are stored. Keep this off any path you might commit.
CONNECTIONS_STORE_PATH=data/connections.json

# ---------------------------------------------------------------------------
# Single-user local development fallback.
#
# Used only when a request arrives with no session at all. It is the old
# pre-OAuth setup, kept working so an existing checkout keeps running, and it
# can only ever describe one workspace - it is not a deployment path.
#
# The four data source ids have no defaults: a default here pointed every
# install at one specific workspace, which is what made the product
# single-user in the first place.
# ---------------------------------------------------------------------------

NOTION_API_KEY=
NOTION_AREAS_DATA_SOURCE_ID=
NOTION_TOPICS_DATA_SOURCE_ID=
NOTION_PROJECTS_DATA_SOURCE_ID=
NOTION_RESOURCES_DATA_SOURCE_ID=
