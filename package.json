{
  "name": "second-brain-intelligence-layer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "classify": "node dist/backend/src/cli/classify.js",
    "classify:notion": "npm run build && node dist/backend/src/cli/classify-notion.js",
    "taxonomy:notion": "npm run build && node dist/backend/src/cli/notion-taxonomy.js",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "evaluate": "npm run build && node dist/backend/src/cli/evaluate-gold.js",
    "evaluate:notion": "npm run build && node dist/backend/src/cli/evaluate-gold.js --notion"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
